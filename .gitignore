# 依赖（由 npm install 生成，不入库）
node_modules/

# 构建产物（由 esbuild 生成，不入库；发布时再构建 / 用 GitHub Release）
main.js
*.js.map
dist/

# 本地发布归档（与根目录 main.js/manifest.json 完全重复；用 git tag / GitHub Release 管理历史版本）
版本/

# AI 助手工作记忆（本地上下文，不入库）
.workbuddy/

# 本地归档备份（被归档的旧文档/旧原型，不入库）
归档.zip

# 测试文件与测试基础设施（仅本地跑测试用，不入库；仓库只放源码）
**/*.test.ts
src/test/
vitest.config.ts

# 设计原型（开发期 HTML 原型，非插件源码，不入库）
redesign/

# 系统 / 编辑器临时文件
.DS_Store
*.log
Thumbs.db
.obsidian/
