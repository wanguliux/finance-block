# Normalize line endings: repo stores LF, checkouts follow this rule.
# Prevents "whole-file diff" churn across Windows/macOS/Linux contributors.
* text=auto eol=lf

# Source & config files explicitly LF
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binary assets (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
